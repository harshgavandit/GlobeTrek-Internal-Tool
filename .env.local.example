# PostgreSQL is mandatory. The application never uses file, browser or memory persistence.
DATABASE_URL=postgresql://globetrek_app:CHANGE_ME@localhost:5432/globetrek
# Use https://your-internal-host for deployment. HTTP is only permitted on loopback.
APP_URL=http://localhost:3001
# Set require for hosted PostgreSQL with a trusted CA. Never disable certificate verification.
PGSSL=disable
# Initial setup only; bootstrap refuses to overwrite an existing administrator.
ADMIN_EMAIL=admin@your-company.example
ADMIN_NAME=Administrator
ADMIN_PASSWORD=SET_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
